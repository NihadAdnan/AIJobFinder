<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Job Finder</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Bootstrap & Custom CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-gradient-dark min-vh-100 d-flex flex-column text-body">
    <!-- Clean Top Navigation -->
    <header class="sticky-top glass-navbar shadow-sm">
        <div class="container-fluid px-lg-5 py-2 d-flex align-items-center justify-content-between">
            <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/">
                <div class="brand-icon-box">
                    <i class="bi bi-cpu-fill"></i>
                </div>
                <span class="brand-title">AI Job Finder</span>
            </a>

            <div class="d-flex align-items-center gap-2">
                <!-- Ollama Status Pill -->
                <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2 rounded-pill px-3 py-1" id="ollamaStatusBtn" data-bs-toggle="modal" data-bs-target="#settingsModal" title="Ollama Settings">
                    <span class="status-dot status-dot-checking" id="ollamaStatusDot"></span>
                    <span id="ollamaStatusText" class="small fw-medium">Checking Ollama...</span>
                    <i class="bi bi-gear text-muted"></i>
                </button>

                <!-- Theme Switcher -->
                <button class="btn btn-sm btn-outline-secondary rounded-circle theme-toggle-btn" id="themeToggleBtn" type="button" title="Toggle Theme">
                    <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1 py-4">
        <div class="container-fluid px-lg-5">
            @RenderBody()
        </div>
    </main>

    <!-- Settings Modal -->
    <div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card border-0 shadow-lg">
                <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                    <h5 class="modal-title d-flex align-items-center gap-2" id="settingsModalLabel">
                        <i class="bi bi-sliders text-primary"></i> Ollama Settings
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label for="settingsBaseUrl" class="form-label small fw-semibold">Ollama URL</label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="settingsBaseUrl" value="http://localhost:11434" placeholder="http://localhost:11434">
                            <button class="btn btn-outline-primary" type="button" id="btnTestOllama">Test</button>
                        </div>
                        <div class="form-text small" id="ollamaTestFeedback"></div>
                    </div>

                    <div class="mb-3">
                        <label for="settingsChatModel" class="form-label small fw-semibold">LLM Model</label>
                        <input type="text" class="form-control" id="settingsChatModel" value="llama3.1:8b" placeholder="llama3.1:8b">
                    </div>

                    <div class="mb-3">
                        <label for="settingsEmbeddingModel" class="form-label small fw-semibold">Embedding Model</label>
                        <input type="text" class="form-control" id="settingsEmbeddingModel" value="nomic-embed-text" placeholder="nomic-embed-text">
                    </div>
                </div>
                <div class="modal-footer border-top border-secondary border-opacity-25 pt-3">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="btnSaveSettings" data-bs-dismiss="modal">Save</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Minimal Footer -->
    <footer class="footer py-3 mt-auto border-top border-secondary border-opacity-25 glass-footer">
        <div class="container-fluid px-lg-5 d-flex align-items-center justify-content-between text-muted small">
            <div>&copy; @DateTime.UtcNow.Year AI Job Finder</div>
            <div class="text-secondary">Stateless &bull; Zero Storage</div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
